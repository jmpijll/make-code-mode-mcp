# =============================================================================
# Make.com Code-Mode MCP — Configuration
# =============================================================================
# Single-user mode: set the credentials below. The server reads these on
# startup and uses them for every request.
#
# Multi-user mode: leave the credentials below empty (or unset) and run with
# MCP_TRANSPORT=http. The MCP client must then send credentials in HTTP
# headers on each request:
#   X-Make-Api-Key, X-Make-Base-Url
#
# Sandbox surface (single flat namespace):
#   - make.<tag>.<op>(args)                            typed operationId call
#   - make.callOperation('opId', args)                 flat lookup
#   - make.request({ method, path, ... })              raw HTTP escape hatch
#
# See docs/multi-tenant.md and docs/usage.md for details.
# =============================================================================

# ─── Transport ────────────────────────────────────────────────────────────
# stdio (default, single-user) | http (Streamable HTTP — required for multi-user)
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8000
# Comma-separated allowlist for HTTP transport (default: localhost only).
# Set to "*" to allow any origin (NOT recommended for production).
MCP_HTTP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ─── Make.com Web API v2 ─────────────────────────────────────────────────
# Base URL of the Make.com zone. Choose the zone where your Make organisation
# lives. Known zones (Authorization: Token <api-key> for all of them):
#   https://eu1.make.com/api/v2          (default)
#   https://eu2.make.com/api/v2
#   https://us1.make.com/api/v2
#   https://us2.make.com/api/v2
#   https://eu1.make.celonis.com/api/v2  (Celonis EU1)
#   https://us1.make.celonis.com/api/v2  (Celonis US1)
MAKE_BASE_URL=https://eu1.make.com/api/v2

# Your Make.com API token. Mint one in:
#   Profile -> API/MCP access -> Add token
# Tick the scopes (resource:read / resource:write) you want available.
# IMPORTANT: scopes are per-token; an operation that needs `scenarios:write`
# returns HTTP 403 if your token lacks that scope.
MAKE_API_KEY=

# ─── Spec Loading ────────────────────────────────────────────────────────
# Override the OpenAPI URL. By default the server fetches
#   ${MAKE_BASE_URL}/openapi.json
# and falls back to the bundled snapshot in src/spec/make-fallback.json.
MAKE_SPEC_URL=

# Where to cache fetched OpenAPI specs on disk.
# Default: ~/.cache/make-code-mode-mcp/
MAKE_SPEC_CACHE_DIR=

# ─── Sandbox Limits ──────────────────────────────────────────────────────
# Maximum API calls per execute() invocation. Bump for big sweeps; remember
# Make's per-minute rate limits: 60 (Core), 120 (Pro), 240 (Teams),
# 1000 (Enterprise).
MAKE_MAX_CALLS_PER_EXECUTE=50

# Wall-clock deadline for execute() invocations in milliseconds. Default 30s.
MAKE_EXECUTE_TIMEOUT_MS=30000
