{
  "name": "make-code-mode-mcp",
  "version": "0.1.0-beta.1",
  "description": "Code-mode MCP server for the Make.com Web API v2. Two tools (search + execute) with QuickJS WASM sandbox plus an optional Cloudflare Workers entry. Single-user (env) and multi-user (per-request HTTP headers) modes.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "make-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/spec',{recursive:true});if(fs.existsSync('src/spec/make-fallback.json'))fs.copyFileSync('src/spec/make-fallback.json','dist/spec/make-fallback.json');\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/ scripts/ cf-worker/ --ext .ts",
    "lint:fix": "eslint src/ scripts/ cf-worker/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"cf-worker/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"cf-worker/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "update-spec": "tsx scripts/update-spec.ts",
    "live-test": "tsx scripts/live-test.ts",
    "discover": "tsx scripts/discover.ts",
    "cf:dev": "wrangler dev --config cf-worker/wrangler.toml",
    "cf:deploy": "wrangler deploy --config cf-worker/wrangler.toml"
  },
  "keywords": [
    "make.com",
    "integromat",
    "mcp",
    "model-context-protocol",
    "code-mode",
    "openapi",
    "automation",
    "scenarios"
  ],
  "author": "Jamie van der Pijll <jmpijll@users.noreply.github.com> (https://github.com/jmpijll)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmpijll/make-code-mode-mcp.git"
  },
  "homepage": "https://github.com/jmpijll/make-code-mode-mcp#readme",
  "bugs": {
    "url": "https://github.com/jmpijll/make-code-mode-mcp/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@cloudflare/codemode": "^0.4.0",
    "@cloudflare/workers-types": "^4.20260615.1",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "dotenv": "^17.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "quickjs-emscripten": "^0.32.0",
    "undici": "^8.3.0",
    "zod": "^4.4.3"
  }
}
